# Optional. Tests and npm run demo ignore credentials and use deterministic fakes.
HOST=127.0.0.1
# Optional self-host mode. Leave blank to keep local mode unchanged.
PUBLIC_BASE_URL=
CR_ALLOWED_TWITCH_USER_ID=
CR_SESSION_SECRET=
CR_OVERLAY_TOKEN=
# Hosted defaults: /data/credits-roll.sqlite, /data/credits-ledger.jsonl,
# /data/debug-log.jsonl, /data/supervisor-alert.json, /data/tokens.json.
# In hosted mode, set DATABASE_PATH=/data/credits-roll.sqlite (or leave it unset).
PORT=3000
DATABASE_PATH=data/credits-roll.sqlite
# Optional local credit history. Must resolve outside this repository.
# Default: ~/.credits-roll/credits-ledger.jsonl (USERPROFILE on Windows).
CREDITS_LEDGER_PATH=
# Temporary local diagnostics, default next to the ledger. Must be outside the repo.
CR_DEBUG_LOG_PATH=
# Persistent restart-limit alert; defaults next to the ledger, outside the repo.
CR_SUPERVISOR_ALERT_PATH=
CR_ONCHAIN_ENABLED=false
CHAT_SOURCE=recorded
# Additional service account logins, comma separated and case insensitive.
IGNORED_LOGINS=
# Optional JSONL path for the local server. The demo supplies its own recording.
RECORDED_CHAT_PATH=
JUDGE=fake
ENABLE_DEV_ENDPOINTS=false
# Optional Twitch Authorization Code flow. Leave blank for the offline demo.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/auth/callback
# Must resolve outside this repository. Default: ~/.credits-roll/tokens.json
TWITCH_TOKEN_PATH=
# Optional OpenAI adapters. Raw audio is not persisted.
OPENAI_API_KEY=
OPENAI_JUDGE_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Auto transcription fallback when Twitch stream language is unavailable (ISO 639-1).
CR_TRANSCRIPTION_LANGUAGE=en
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional non-negative compensation for measured HLS audio delay, in milliseconds.
AUDIO_DELAY_MS=0
