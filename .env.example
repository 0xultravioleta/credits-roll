# Optional. Tests and npm run demo ignore credentials and use deterministic fakes.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=data/credits-roll.sqlite
CHAT_SOURCE=recorded
# Optional JSONL path for the local server. The demo supplies its own recording.
RECORDED_CHAT_PATH=
JUDGE=fake
ENABLE_DEV_ENDPOINTS=false
# Optional Twitch Authorization Code flow. Leave blank for the offline demo.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/auth/callback
# Must resolve outside this repository. Default: ~/.credits-roll/tokens.json
TWITCH_TOKEN_PATH=
# Optional OpenAI adapters. Raw audio is not persisted.
OPENAI_API_KEY=
OPENAI_JUDGE_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional non-negative compensation for measured HLS audio delay, in milliseconds.
AUDIO_DELAY_MS=0
